# ── Required ────────────────────────────────────────────────────────────────
# Get a token from @BotFather on Telegram: /newbot → copy the token
BOT_TOKEN=123456789:AAE_your_botfather_token_here

# ── Optional ────────────────────────────────────────────────────────────────
# HTTP port (deploy platforms usually set this automatically)
# PORT=3000

# Webhook mode: set to your public base URL (or full webhook URL).
# When unset, the bot uses long-polling (fine for local development).
# WEBHOOK_URL=https://your-app.example.com

# Recommended with webhooks: any long random string. Telegram echoes it back
# in the X-Telegram-Bot-Api-Secret-Token header, and the server rejects
# requests that don't match.
# WEBHOOK_SECRET=change-me-to-something-long-and-random

# Where notes.json is stored (defaults to ./data)
# DATA_DIR=./data
